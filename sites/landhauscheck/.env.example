# Shared
APP_ENV=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Frontend
VITE_API_BASE_URL=http://localhost:8000
# HERE Maps JS API key — safe for browser use (map rendering only)
VITE_HERE_API_KEY=your_here_api_key

# Backend — same key used server-side for Transit API proxy (not exposed to browser)
HERE_API_KEY=your_here_api_key

# Database (reserved for Step 2)
DATABASE_URL=postgresql+psycopg://app_user:app_password@localhost:5432/basic_webapp
POSTGRES_DB=basic_webapp
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_HOST_PORT=55432
