  "subtitles": [
    {
      "start": 0.8,
      "end": 7.5,
      "text": {
        "en": "The capital’s gates stand open, but no one comes to greet you.",
        "de": "Die Tore der Hauptstadt stehen offen, aber niemand kommt, um dich zu begrüßen."
      }
    },
    {
      "start": 7.9,
      "end": 17.6,
      "text": {
        "en": "Market stalls float above the cobbles. Clocks run backward. Palace banners hang perfectly still in a howling wind.",
        "de": "Marktstände schweben über dem Pflaster. Uhren laufen rückwärts. Die Banner des Palasts hängen ganz still im heulenden Wind."
      }
    },
    {
      "start": 18,
      "end": 26.9,
      "text": {
        "en": "The adviser’s strongest fiends hunt through the streets, combining the tricks you have already overcome.",
        "de": "Die stärksten Feinde des Beraters jagen durch die Straßen und verbinden alle Tricks, die du schon besiegt hast."
      }
    },
    {
      "start": 27.3,
      "end": 32.6,
      "text": {
        "en": "A sequence of correct answers lights the sky.",
        "de": "Eine Reihe richtiger Antworten lässt den Himmel leuchten."
      }
    },
    {
      "start": 33,
      "end": 43.1,
      "text": {
        "en": "The ancient dragon descends, and for the first time since dawn was stolen, the city hears a hopeful sound.",
        "de": "Der uralte Drache steigt herab, und zum ersten Mal, seit der Morgen gestohlen wurde, hört die Stadt einen hoffnungsvollen Klang."
      }
    },
    {
      "start": 43.5,
      "end": 47.8,
      "kind": "title",
      "text": {
        "en": "Act V: The Silent Capital · Levels 41–50",
        "de": "Akt V: Die stille Hauptstadt · Level 41–50"
      }
    }
  ]
