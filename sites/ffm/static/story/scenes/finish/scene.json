  "subtitles": [
    {
      "start": 0.8,
      "end": 4.8,
      "kind": "title",
      "text": {
        "en": "A World in Balance",
        "de": "Eine Welt im Gleichgewicht"
      }
    },
    {
      "start": 5.2,
      "end": 14.9,
      "text": {
        "en": "The final answer lands. The Crown cracks, and the stolen dawn pours through the throne-room windows.",
        "de": "Die letzte Antwort sitzt. Die Krone bekommt einen Riss, und der gestohlene Morgen strömt durch die Fenster des Thronsaals."
      }
    },
    {
      "start": 15.3,
      "end": 24.4,
      "text": {
        "en": "Across the kingdom, rivers settle into their banks. Roads return to their destinations.",
        "de": "Überall im Königreich kehren die Flüsse in ihr Bett zurück. Die Straßen führen wieder dorthin, wo sie hingehören."
      }
    },
    {
      "start": 24.8,
      "end": 29.7,
      "text": {
        "en": "In your village, the bells ring once.",
        "de": "In deinem Dorf läuten die Glocken ein einziges Mal."
      }
    },
    {
      "start": 30.1,
      "end": 38.2,
      "text": {
        "en": "You place the restored Crown beside the empty throne. Then you turn toward home.",
        "de": "Du legst die wiederhergestellte Krone neben den leeren Thron. Dann machst du dich auf den Heimweg."
      }
    },
    {
      "start": 38.6,
      "end": 47,
      "text": {
        "en": "The dragon circles overhead as sunlight reaches the road you fought so hard to follow.",
        "de": "Der Drache kreist über dir, während das Sonnenlicht die Straße erreicht, der du so mutig gefolgt bist."
      }
    },
    {
      "start": 47.4,
      "end": 54.5,
      "text": {
        "en": "Your spellbook is heavier now, its pages bright with wind, storm, and earth.",
        "de": "Dein Zauberbuch ist jetzt schwerer, seine Seiten leuchten von Wind, Sturm und Erde."
      }
    },
    {
      "start": 54.9,
      "end": 59.6,
      "text": {
        "en": "On the last page, fresh ink begins to form.",
        "de": "Auf der letzten Seite bildet sich frische Tinte."
      }
    },
    {
      "start": 60,
      "end": 64,
      "text": {
        "en": "**Every answer opens another path.**",
        "de": "**Jede Antwort öffnet einen neuen Weg.**"
      }
    }
  ]
}
