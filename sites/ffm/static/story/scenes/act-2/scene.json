  "subtitles": [
    {
      "start": 0.8,
      "end": 8.5,
      "text": {
        "en": "The path climbs into mountains where broken watchtowers cling to the cliffs.",
        "de": "Der Pfad steigt hinauf in die Berge, wo sich zerfallene Wachtürme an die Felswände klammern."
      }
    },
    {
      "start": 8.9,
      "end": 17.1,
      "text": {
        "en": "Lightning leaps between their roofs, carrying stolen pieces of the Crown’s magic toward the capital.",
        "de": "Blitze springen von Dach zu Dach und tragen gestohlene Stücke vom Zauber der Krone zur Hauptstadt."
      }
    },
    {
      "start": 17.5,
      "end": 28,
      "text": {
        "en": "Your spellbook opens to a page you have never seen: a dragon curled around a chain of shining numbers.",
        "de": "Dein Zauberbuch öffnet sich auf einer Seite, die du noch nie gesehen hast: ein Drache, der sich um eine Kette leuchtender Zahlen rollt."
      }
    },
    {
      "start": 28.4,
      "end": 32.4,
      "text": {
        "en": "Beneath it, one sentence appears:",
        "de": "Darunter erscheint ein einziger Satz:"
      }
    },
    {
      "start": 32.8,
      "end": 37.9,
      "text": {
        "en": "**A steady mind can wake what thunder cannot.**",
        "de": "**Ein ruhiger Geist kann wecken, was kein Donner weckt.**"
      }
    },
    {
      "start": 38.3,
      "end": 42.4,
      "kind": "title",
      "text": {
        "en": "Act II: The Long Country · Levels 11–20",
        "de": "Akt II: Das weite Land · Level 11–20"
      }
    }
  ]
