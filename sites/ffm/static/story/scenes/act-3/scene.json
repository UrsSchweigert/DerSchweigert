  "subtitles": [
    {
      "start": 0.8,
      "end": 7.9,
      "text": {
        "en": "Deep in the woods, leaves whisper wrong answers and roots rearrange the trail.",
        "de": "Tief im Wald flüstern die Blätter falsche Antworten, und Wurzeln verlegen den Pfad."
      }
    },
    {
      "start": 8.3,
      "end": 17.2,
      "text": {
        "en": "Each new kind of fiend has a different trick, and familiar-looking problems hide unfamiliar dangers.",
        "de": "Jede neue Art von Feind hat einen anderen Trick, und Aufgaben, die vertraut aussehen, verbergen neue Gefahren."
      }
    },
    {
      "start": 17.6,
      "end": 25.1,
      "text": {
        "en": "Your fireballs light the way. Your growing earth magic holds the shifting ground steady.",
        "de": "Deine Feuerbälle erhellen den Weg. Deine wachsende Erdmagie hält den wankenden Boden fest."
      }
    },
    {
      "start": 25.5,
      "end": 31.1,
      "text": {
        "en": "Beyond the bridge, thunder rolls from a cloudless sky.",
        "de": "Hinter der Brücke grollt Donner aus einem wolkenlosen Himmel."
      }
    },
    {
      "start": 31.5,
      "end": 36,
