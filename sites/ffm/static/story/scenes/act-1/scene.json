  "subtitles": [
    {
      "start": 0.8,
      "end": 10.4,
      "text": {
        "en": "The village lanterns fade behind you as you follow the crooked road through orchards and abandoned farms.",
        "de": "Die Laternen des Dorfes verblassen hinter dir, während du der krummen Straße durch Obstgärten und verlassene Höfe folgst."
      }
    },
    {
      "start": 10.8,
      "end": 18.9,
      "text": {
        "en": "Small fiends steal signposts, scramble milestones, and scatter your neighbours’ belongings.",
        "de": "Kleine Feinde stehlen Wegweiser, verdrehen Meilensteine und verstreuen die Sachen deiner Nachbarn."
      }
    },
    {
      "start": 19.3,
      "end": 29.1,
      "text": {
        "en": "Your first spells are little more than sparks and gusts. But with each victory, the road straightens beneath your feet.",
        "de": "Deine ersten Zauber sind kaum mehr als Funken und Windstöße. Doch mit jedem Sieg wird die Straße unter deinen Füßen gerader."
      }
    },
    {
      "start": 29.5,
      "end": 33.6,
      "text": {
        "en": "Someone is afraid you will.",
        "de": "Jemand fürchtet, dass dir das gelingt."
      }
    },
    {
      "start": 34,
