  "subtitles": [
    {
      "start": 0.8,
      "end": 8.3,
      "text": {
        "en": "On the morning the sun failed to rise, every bell in the village rang thirteen times.",
        "de": "An dem Morgen, an dem die Sonne nicht aufging, läuteten alle Glocken im Dorf dreizehnmal."
      }
    },
    {
      "start": 8.7,
      "end": 18.1,
      "text": {
        "en": "Far beyond the fields, the king’s adviser had stolen the Crown of Balance and twisted its magic.",
        "de": "Weit hinter den Feldern hatte der Berater des Königs die Krone des Gleichgewichts gestohlen und ihren Zauber verdreht."
      }
    },
    {
      "start": 18.5,
      "end": 27.8,
      "text": {
        "en": "Roads folded into loops. Rivers flowed uphill. Fiends prowled the path to the royal throne room.",
        "de": "Straßen verknoteten sich zu Schleifen. Flüsse flossen bergauf. Feinde lauerten auf dem Weg zum Thronsaal des Königs."
      }
    },
    {
      "start": 28.2,
      "end": 36.6,
      "text": {
        "en": "You are the village apprentice who notices what everyone else is missing: the chaos follows a pattern.",
        "de": "Du bist der Lehrling des Dorfes und bemerkst, was alle anderen übersehen: Das Chaos folgt einem Muster."
      }
    },
    {
      "start": 37,
      "end": 45.4,
      "text": {
        "en": "Armed with spells and a talent for numbers, you set out to put the world right.",
        "de": "Mit Zaubersprüchen und einem Talent für Zahlen ziehst du los, um die Welt wieder in Ordnung zu bringen."
      }
    },
    {
      "start": 45.8,
      "end": 52.7,
      "text": {
        "en": "Every correct answer fuels your magic. Every level strengthens your spells.",
        "de": "Jede richtige Antwort nährt deine Magie. Jedes Level macht deine Zauber stärker."
      }
    },
    {
      "start": 53.1,
      "end": 61.2,
      "text": {
        "en": "Keep your answers true in an unbroken sequence, and an ancient dragon will answer your call.",
        "de": "Gib Antwort um Antwort richtig, ohne Fehler dazwischen – dann folgt ein uralter Drache deinem Ruf."
      }
    },
    {
      "start": 61.6,
      "end": 65.6,
      "kind": "title",
      "text": {
        "en": "The Stolen Dawn",
        "de": "Der gestohlene Morgen"
      }
    }
  ]
}
