  "subtitles": [
    {
      "start": 0.8,
      "end": 5.4,
      "text": {
        "en": "For generations, six great wards have kept the kingdom safe.",
        "de": "Seit Generationen schützen sechs große Schutzsiegel das Königreich."
      }
    },
    {
      "start": 5.8,
      "end": 11.0,
      "text": {
        "en": "Their runes guide the rivers, guard the harvest, and hold the night beyond the door.",
        "de": "Ihre Runen lenken die Flüsse, behüten die Ernte und halten die Nacht vor der Tür."
      }
    },
    {
      "start": 11.4,
      "end": 15.0,
      "text": {
        "en": "Last night, something broke them.",
        "de": "Letzte Nacht hat etwas sie zerbrochen."
      }
    },
    {
      "start": 15.4,
      "end": 22.2,
      "text": {
        "en": "Now strange creatures walk the roads, and a voice from the distant palace calls itself the Hollow King.",
        "de": "Nun ziehen seltsame Kreaturen über die Wege, und eine Stimme aus dem fernen Palast nennt sich der Hohle König."
      }
    },
    {
      "start": 22.6,
      "end": 27.7,
      "text": {
        "en": "At your village gate, you find an old sword buried beneath a fallen rune-stone.",
        "de": "Am Tor deines Dorfes findest du ein altes Schwert unter einem umgestürzten Runenstein."
      }
    },
    {
      "start": 28.0,
      "end": 33.2,
      "text": {
        "en": "As you lift it, a question shines along the blade. You speak the answer.",
        "de": "Als du es hebst, leuchtet eine Frage auf der Klinge. Du sprichst die Antwort."
      }
    },
    {
      "start": 33.6,
      "end": 38.2,
      "text": {
        "en": "The sword lights up. Beyond the fence, something stirs.",
        "de": "Das Schwert erstrahlt. Hinter dem Zaun regt sich etwas."
      }
    },
    {
      "start": 38.6,
      "end": 42.6,
      "text": {
        "en": "Your journey begins at home.",
        "de": "Deine Reise beginnt zu Hause."
      }
    }
  ]
}
